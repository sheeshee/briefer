# /etc/briefer/claude.env — credentials for the advisory Claude verify pass.
# Only briefer-verify reads this file; it is never passed to PocketBase.
# Either run `claude setup-token` as the briefer user and paste the token here,
# or leave both empty and log in interactively once with `sudo -iu briefer claude`.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
