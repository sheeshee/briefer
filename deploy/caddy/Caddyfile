# Installed to /etc/caddy/Caddyfile by bootstrap.sh. Hostnames and the DNS
# provider token come from /etc/caddy/caddy.env. Both names should resolve to
# the Pi's NetBird IP; certificates are issued via the ACME DNS-01 challenge, so
# the Pi never needs to be reachable from the internet.
{
	email {$ACME_EMAIL}
}

(dns_tls) {
	import /etc/caddy/tls.caddy
}

{$BRIEFER_HOST} {
	import dns_tls
	encode zstd gzip
	reverse_proxy 127.0.0.1:8090
}

{$BRIEFER_STAGING_HOST} {
	import dns_tls
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:8091
}
