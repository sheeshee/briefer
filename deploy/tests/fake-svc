#!/usr/bin/env bash
# Test double for `systemctl --user` that runs briefer@<env> as a real
# PocketBase process, mirroring deploy/systemd/briefer@.service.
set -euo pipefail
cmd="$1"; unit="${!#}"  # unit is always the last argument
env="${unit#briefer@}"; env="${env%.service}"
pidfile="$BRIEFER_RUN/$env.pid"

running() { [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }

do_stop() {
  if running; then
    local pid; pid="$(cat "$pidfile")"
    kill "$pid"
    for _ in $(seq 1 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  fi
  rm -f "$pidfile"
}

do_start() {
  running && return 0
  set -a
  # shellcheck disable=SC1090
  . "$BRIEFER_ETC/$env.env"
  set +a
  local cur="$BRIEFER_ROOT/envs/$env/current"
  mkdir -p "$BRIEFER_DATA/$env"
  (cd "$cur" && exec ./pocketbase serve --http "127.0.0.1:$BRIEFER_PORT" --dir "$BRIEFER_DATA/$env" \
     --hooksDir pb_hooks --migrationsDir pb_migrations --publicDir pb_public --hooksPool 2 \
     >> "$BRIEFER_RUN/$env.log" 2>&1) 3>&- 9>&- </dev/null &
  echo $! > "$pidfile"
  # Like systemd, return once the process is spawned, not when it is healthy.
  # fds 3 (bats) and 9 (deploy lock) are closed so the child doesn't hold them.
  sleep 0.2
  if ! running; then rm -f "$pidfile"; return 1; fi
}

case "$cmd" in
  start) do_start ;;
  stop) do_stop ;;
  restart) do_stop; do_start ;;
  is-active) running && echo active || { echo inactive; exit 3; } ;;
  show) running && cat "$pidfile" || echo 0 ;;   # only `show -p MainPID --value` is used
  daemon-reload|enable|disable) ;;
  *) echo "fake-svc: unsupported $cmd" >&2; exit 2 ;;
esac
